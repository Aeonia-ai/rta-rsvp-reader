{
  "name": "rta-rsvp-reader",
  "version": "0.1.0",
  "description": "A CLI-controlled, WebSocket-driven RSVP reader for low-resolution AR displays.",
  "private": true,
  "type": "module",
  "bin": {
    "rsvp": "dist/server/entrypoints/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import tsx --test",
    "typecheck": "tsc --noEmit",
    "check:fast": "npm run typecheck && npm test",
    "contracts:replay": "node --import tsx scripts/contract-replay.ts",
    "dev": "tsx src/entrypoints/server.ts",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "install:cli": "node scripts/install-cli.mjs",
    "setup": "npm run build && npm run install:cli",
    "start": "node dist/server/entrypoints/server.js"
  },
  "dependencies": {
    "@siderealmollusk/rta": "0.6.0",
    "effect": "3.21.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.62.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.6"
  }
}
